# Usually automatic: web uses the local CORS proxy at :3001 and Expo Go
# uses the Metro host's LAN address at :3000.
# Android emulator override: http://10.0.2.2:3000
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Optional public/readable object-storage base URL, including bucket if needed.
# GIFs and user avatars use signed URLs returned by the API.
# EXPO_PUBLIC_MEDIA_BASE_URL=http://192.168.1.10:9000/reducto

# Local web proxy only:
API_TARGET=http://127.0.0.1:3000
PROXY_PORT=3001
